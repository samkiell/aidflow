# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/aidflow

# Stellar network: testnet or public
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Optional Soroban contract ID after reviewed deployment
AIDFLOW_CONTRACT_ID=

# Server-side token for the temporary restricted campaign bootstrap endpoint.
# Generate a long random value and keep it server-side. Never prefix with NEXT_PUBLIC_.
AIDFLOW_CAMPAIGN_ADMIN_TOKEN=
