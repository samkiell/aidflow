# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/aidflow

# Stellar network: testnet or public
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Optional Soroban contract ID after deployment and API integration
AIDFLOW_CONTRACT_ID=

# Server-side bootstrap token for admin campaign creation.
# Generate at least 32 random characters and keep it server-side.
AIDFLOW_CAMPAIGN_ADMIN_TOKEN=

# Separate server-side token for organization verification/rejection.
# Generate a different value of at least 32 random characters.
AIDFLOW_REVIEW_TOKEN=
